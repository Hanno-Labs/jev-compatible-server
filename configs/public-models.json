      "config": {
        "decision.readout": "pointer_head",
        "decision.backbone": "Qwen/Qwen3-0.6B-Base",
        "decision.adapter": "auto",
        "decision.head_path": "head.pt",
        "decision.head_repo": "jaredpalmer/kev-0.6b",
        "decision.packing": {
          "state_token": "<|fim_prefix|>",
          "question_token": "<|fim_middle|>",
          "option_start": "<|box_start|>",
          "option_end": "<|box_end|>",
          "decision_token": "<|fim_suffix|>"
        }
      }
    },
    "kev-4b": {
      "backend": "transformers",
      "model": "jaredpalmer/kev-4b",
      "description": "Kev Qwen3.5-4B pointer-head model",
      "support_status": "supported",
      "config": {
        "decision.readout": "pointer_head",
        "decision.backbone": "Qwen/Qwen3.5-4B-Base",
        "decision.adapter": "auto",
        "decision.head_path": "head.pt",
        "decision.head_repo": "jaredpalmer/kev-4b",
        "decision.packing": {
          "state_token": "<|fim_prefix|>",
          "question_token": "<|fim_middle|>",
          "option_start": "<|box_start|>",
          "option_end": "<|box_end|>",
          "decision_token": "<|fim_suffix|>"
        }
      }
    },
    "kev-8b": {
      "backend": "transformers",
      "model": "jaredpalmer/kev-8b",
      "description": "Kev Qwen3-8B pointer-head model",
      "support_status": "supported",
      "config": {
        "decision.readout": "pointer_head",
        "decision.backbone": "Qwen/Qwen3-8B-Base",
        "decision.adapter": "auto",
        "decision.head_path": "head.pt",
        "decision.head_repo": "jaredpalmer/kev-8b",
        "decision.packing": {
          "state_token": "<|fim_prefix|>",
          "question_token": "<|fim_middle|>",
          "option_start": "<|box_start|>",
          "option_end": "<|box_end|>",
          "decision_token": "<|fim_suffix|>"
        }
      }
    },
    "nanojev": {
      "backend": "transformers",
      "model": "C-Tianyu/NanoJev",
      "description": "Qwen3-0.6B attention-based candidate-set head",
      "support_status": "pending",
      "enabled": false
    },
    "open-jev-deberta-v3-large": {
      "backend": "transformers",
      "model": "com-kotobalabs/open-jev-deberta-v3-large",
      "description": "DeBERTa encoder with option scoring head",
