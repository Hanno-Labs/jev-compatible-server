{
  "default": "kev-4b",
  "recipes": {
    "hidden-state-probe-v1": {
      "decision": {
        "readout": "hidden_state_probe",
        "hidden": {
          "token": "last_non_pad"
        },
        "dtype": "bfloat16",
        "batch_size": 8
      }
    },
    "hidden-state-candidate-verifier-v1": {
      "decision": {
        "readout": "hidden_state_probe",
        "question_types": [
          "choice",
          "score",
          "noul"
        ],
        "hidden": {
          "token": "last_non_pad"
        },
        "dtype": "bfloat16",
        "batch_size": 8,
        "instruction_adapters": {
          "choice": "",
          "score": "",
          "noul": ""
        },
        "candidates": {
          "choice": {
            "criterion_template": "{key}: {criterion}",
            "empty_criterion_template": "{key}"
          },
          "score": {
            "criterion_template": "{criterion}"
          },
          "noul": {
            "no_criteria_options": {
              "true": "yes",
              "false": "no"
            },
            "criterion_template": "{criterion}"
          }
        },
        "aggregation": {
          "choice_temperature": 1.0,
          "score_temperature": 1.0,
          "noul_a": 1.0,
          "noul_b": 0.0,
          "noul_mode": "true_false_softmax",
          "confidence": "normalized_entropy"
        }
      }
    },
    "encoder-decoder-yes-no-margin-v1": {
      "decision": {
        "readout": "encoder_decoder_margin",
        "labels": {
          "positive": "yes",
          "negative": "no"
        },
        "encoder": {
          "document_template": "<Document>: {document}",
          "pooling": "mean_chunks",
          "chunk_size": 4
        },
        "decoder": {
          "template": "<bos><start_of_turn>user\nJudge whether the Document meets the requirements based on the Query and the Instruct provided. Note that the answer can only be \"yes\" or \"no\".\n\n<Instruct>: {instruction}\n<Query>: {query}<end_of_turn>\n<start_of_turn>model\n\n\n\n",
          "pad_to_multiple_of": 8
        },
        "instruction_adapters": {
          "choice": "Evaluate whether the candidate option described in the Document is an appropriate answer to the question above, given the information in the Query. Judge the candidate by its stated description, not merely by topical relevance.",
          "score": "Evaluate whether the level described in the Document accurately characterizes the Query with respect to the assessment above. Judge this level by its stated criteria, not merely by topical relevance.",
          "noul": "Given the Query, evaluate whether the candidate criterion in the Document correctly describes the answer to the question above. Answer yes if this candidate criterion is satisfied, otherwise no."
        },
        "candidates": {
          "choice": {
            "criterion_template": "{key}: {criterion}",
            "empty_criterion_template": "{key}"
          },
          "score": {
            "criterion_template": "{criterion}"
          },
          "noul": {
            "no_criteria_template": "{state}",
            "criterion_template": "{criterion}"
          }
        },
        "aggregation": {
          "choice_temperature": 1.0,
          "score_temperature": 1.0,
          "noul_a": 1.0,
          "noul_b": 0.0,
          "confidence": "normalized_entropy"
        },
        "limits": {
          "query": 512,
          "document": 1024,
          "decoder": 2048
        },
        "batch_size": 4,
        "cache": {
          "max_mib": 256
        }
      }
    },
    "sequence-classifier-scalar-options-v1": {
      "decision": {
        "readout": "sequence_classifier_margin",
        "loader": {
          "base_model": "Qwen/Qwen3.5-4B-Base",
          "adapter": "auto",
          "num_labels": 1
        },
        "input": {
          "state_template": "State:\n{state}",
          "tail_template": "\n\nQuestion:\n{instructions}\n\nOption:\n{option}",
          "truncation": "preserve_tail",
          "max_length": 384
        },
        "instruction_adapters": {
          "choice": "",
          "score": "",
          "noul": ""
        },
        "candidates": {
          "choice": {
            "criterion_template": "{key}: {criterion}",
            "empty_criterion_template": "{key}"
          },
          "score": {
            "criterion_template": "{criterion}"
          },
          "noul": {
            "no_criteria_options": {
              "true": "yes",
              "false": "no"
            },
            "criterion_template": "{criterion}"
          }
        },
        "aggregation": {
          "choice_temperature": 1.75,
          "score_temperature": 1.75,
          "noul_a": 0.5714285714285714,
          "noul_b": 0.0,
          "noul_mode": "true_false_softmax",
          "confidence": "max_probability"
        },
        "batch_size": 48
      }
    }
  },
  "models": {
    "kev-0.5b": {
      "backend": "transformers",
      "model": "jaredpalmer/kev-0.5b",
      "description": "Kev prototype, Qwen2.5-0.5B plus pointer head",
      "support_status": "supported",
      "config": {
        "decision.readout": "pointer_head",
        "decision.backbone": "Qwen/Qwen2.5-0.5B",
        "decision.adapter": "auto",
        "decision.head_path": "head.pt",
        "decision.head_repo": "jaredpalmer/kev-0.5b",
        "decision.packing": {
          "state_token": "<|fim_prefix|>",
          "question_token": "<|fim_middle|>",
          "option_start": "<|box_start|>",
          "option_end": "<|box_end|>",
          "decision_token": "<|fim_suffix|>"
        }
      }
    },
    "kev-0.6b": {
