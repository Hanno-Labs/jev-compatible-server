    "ztc-judge-4b": {
      "backend": "transformers",
      "model": "FINAL-Bench/ZTC-Judge-4B",
      "recipe": "hidden-state-candidate-verifier-v1",
      "description": "Question-answer verifier using a final-hidden-state RBF probe",
      "support_status": "supported",
      "config": {
        "decision": {
          "loader": {
            "revision": "b0bb16038d7adbca6f4edda90ac72fb960d8319f",
            "attn_implementation": "sdpa"
          },
          "input": {
            "mode": "candidate_tasks",
            "template": "다음은 어떤 문제와 그에 대한 답변이다. 이 답변이 옳은지 판단하라.\n\n[문제]\n{query}\n\n{instructions}\n\n[답변]\n{candidate}\n\n이 답변은 옳은가?",
            "max_length": 2048
          },
          "probe": {
            "kind": "rbf",
            "repo": "auto",
            "file": "ztc_curve_probe.npz"
          }
        }
      }
    },
    "ztc-judge-9b": {
      "backend": "transformers",
      "model": "FINAL-Bench/ZTC-Judge-9B",
