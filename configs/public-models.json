    "laya-mlx": {
      "backend": "mlx",
      "model": "aac6fef/laya-mlx",
      "description": "MLX bidirectional decision encoder with marker scalar outputs",
      "support_status": "pending",
      "enabled": false,
      "config": {
        "decision.readout": "marker_scalar_head",
        "decision.encoder": "bidirectional",
        "decision.question_types": ["choice", "score", "noul"],
        "decision.output": "option_probabilities"
      }
    }
